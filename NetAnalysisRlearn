## Build igraph and tidygraph

```{r}
ig <- igraph::graph_from_data_frame(
  d        = ed,
  vertices = vi,
  directed = FALSE
)

tg <- tidygraph::as_tbl_graph(ig) |>
  tidygraph::activate(nodes) |>
  dplyr::mutate(label = name)
```

Properties inspection, (Again different values due to different data, but look similar)

```{r}
#concatenate and print properties
cat("Nodes:        ", igraph::vcount(ig), "\n",
    "Edges:        ", igraph::ecount(ig), "\n",
    "Density:      ", round(igraph::edge_density(ig), 3), "\n",
    "Diameter:     ", igraph::diameter(ig), "\n",
    "Transitivity: ", round(igraph::transitivity(ig, type = "global"), 3), "\n"
)
```

